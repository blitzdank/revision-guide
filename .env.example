# Copy this file to .env.local and fill in the real values (see SETUP.md).
# Never commit .env.local — it's already in .gitignore.

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The URL this app is reachable at. http://localhost:3000 while developing;
# your Railway URL once deployed (e.g. https://revision-guide.up.railway.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI tutor (Phase 5) — optional. Leave ANTHROPIC_API_KEY blank/unset and the
# app works fully without it, with every AI button hidden. See SETUP.md.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_DAILY_MESSAGE_LIMIT=30
